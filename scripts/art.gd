class_name LabArt
extends RefCounted

const BG = Color("0a131d")
const PANEL = Color("132331")
const LINE = Color("355064")
const TEXT = Color("eff8fa")
const MUTED = Color("9eb2c0")
const TEAL = Color("55edc7")
const AMBER = Color("ffc879")
const RED = Color("ff8179")
const BALLISTIC_WEAPONS = ["pistol","revolver","rifle","shotgun","sawed","nailgun","turret","flak","crossbow","rocket_gun","harpoon","cannon","minigun","grapple"]
const ENERGY_WEAPONS = ["railgun","flamer","freezer","tesla_gun","glue_gun","bouncer","pulse_gun","mine_gun","balloon_gun","vortex","disc_gun","taser","cluster","wind_gun"]
const MELEE_WEAPONS = ["sword","axe","spear","hammer","knife","katana","scythe","mace","chainsaw","bat","whip","plasma_blade","crowbar","halberd","hook"]
const EMITTER_COLORS = {
	"railgun":Color("70d9ff"), "flamer":Color("ffae55"), "freezer":Color("9cecff"),
	"tesla_gun":Color("9badff"), "glue_gun":Color("f5b874"), "bouncer":Color("ff8fa9"),
	"pulse_gun":Color("61ead4"), "mine_gun":Color("f49370"), "balloon_gun":Color("f9a2ce"),
	"vortex":Color("be97ff"), "disc_gun":Color("ffcf72"), "taser":Color("a8e7ff"),
	"cluster":Color("c1df78"), "wind_gun":Color("9adbcf"), "plasma_blade":Color("84edff")
}

static var _glow_texture: GradientTexture2D

static func soft_glow(c: CanvasItem, center: Vector2, radius: float, color: Color, strength: float = 1.0) -> void:
	# One cached radial gradient removes the visible concentric rings and
	# costs one draw command. The texture is generated by Godot at runtime.
	if _glow_texture==null:
		var gradient=Gradient.new()
		gradient.offsets=PackedFloat32Array([0.0,0.28,0.62,1.0])
		gradient.colors=PackedColorArray([Color(1,1,1,0.30),Color(1,1,1,0.15),Color(1,1,1,0.035),Color(1,1,1,0)])
		_glow_texture=GradientTexture2D.new()
		_glow_texture.gradient=gradient
		_glow_texture.width=128
		_glow_texture.height=128
		_glow_texture.fill=GradientTexture2D.FILL_RADIAL
		_glow_texture.fill_from=Vector2(0.5,0.5)
		_glow_texture.fill_to=Vector2(1.0,0.5)
	var extent=Vector2.ONE*radius*1.35
	c.draw_texture_rect(_glow_texture,Rect2(center-extent,extent*2.0),false,Color(color.r,color.g,color.b,color.a*strength))

static func glow_line(c: CanvasItem, from: Vector2, to: Vector2, color: Color, width: float = 2.0) -> void:
	c.draw_line(from,to,Color(color.r,color.g,color.b,0.06),width*6.0,true)
	c.draw_line(from,to,Color(color.r,color.g,color.b,0.16),width*3.0,true)
	c.draw_line(from,to,color,width,true)

static func bolt(c: CanvasItem, point: Vector2, radius: float = 2.0, color: Color = Color("c7d4d9")) -> void:
	c.draw_circle(point,radius+1,Color(0.02,0.04,0.05,0.55))
	c.draw_circle(point,radius,color)
	c.draw_line(point+Vector2(-radius*0.55,0),point+Vector2(radius*0.55,0),color.darkened(0.48),1,true)

static func bevel_box(c: CanvasItem, rect: Rect2, color: Color, radius: float = 5.0, border: Color = Color("8299a8"), depth: float = 3.0) -> void:
	box(c,Rect2(rect.position+Vector2(depth,depth+1),rect.size),Color(0.0,0.015,0.025,0.44),radius)
	LabSurface.plate(c,rect,color,radius,border,true)
	c.draw_line(rect.position+Vector2(radius,2),rect.position+Vector2(rect.size.x-radius,2),color.lightened(0.34),2,true)
	c.draw_line(rect.position+Vector2(rect.size.x-2,radius),rect.position+Vector2(rect.size.x-2,rect.size.y-radius),color.darkened(0.34),2,true)
	c.draw_line(rect.position+Vector2(radius,rect.size.y-2),rect.position+Vector2(rect.size.x-radius,rect.size.y-2),color.darkened(0.42),2,true)

static func weapon_finish(c: CanvasItem, kind: String, color: Color) -> void:
	var all_guns=BALLISTIC_WEAPONS+ENERGY_WEAPONS
	if kind in all_guns:
		var muzzle_x: Dictionary={"pistol":30,"revolver":28,"rifle":38,"shotgun":36,"sawed":26,"nailgun":44,"turret":34,"flak":32,"railgun":34,"crossbow":32,"rocket_gun":32,"flamer":38,"freezer":32,"tesla_gun":29,"harpoon":36,"glue_gun":21,"bouncer":26,"cannon":34,"minigun":31,"pulse_gun":30,"grapple":26,"mine_gun":27,"balloon_gun":27,"vortex":27,"disc_gun":28,"taser":24,"cluster":28,"wind_gun":26}
		var mx=float(muzzle_x.get(kind,30))
		# Receiver seam, raised sight, service screws and a proper muzzle crown.
		c.draw_line(Vector2(-14,-7),Vector2(10,-7),Color(0.82,0.93,0.96,0.24),1,true)
		c.draw_line(Vector2(-9,-10),Vector2(1,-10),Color("91a7b0"),2,true)
		c.draw_line(Vector2(-7,-11),Vector2(-7,-14),Color("a9bbc2"),1.5,true)
		for p in [Vector2(-11,-2),Vector2(5,-2)]: bolt(c,p,1.15,Color("b4c3c9"))
		c.draw_line(Vector2(mx,-4.5),Vector2(mx,4.5),Color("c4d1d6"),2,true)
		c.draw_circle(Vector2(mx,0),2.5,Color("101a20"))
		c.draw_circle(Vector2(mx,0),1.1,color.lightened(0.28))
		if kind in ENERGY_WEAPONS:
			soft_glow(c,Vector2(mx,0),10,Color(color.r,color.g,color.b,0.55),0.9)
			c.draw_arc(Vector2(mx-8,0),7,-1.05,1.05,12,color.lightened(0.22),2,true)
			c.draw_circle(Vector2(mx-8,0),2,Color("e8ffff"))
		else:
			c.draw_line(Vector2(mx-5,-5),Vector2(mx-1,-8),Color("71858e"),2,true)
		# Layered grip wrap remains readable even at catalog scale.
		if kind in ["pistol","revolver","nailgun","flak","glue_gun"]:
			for y in range(9,18,3): c.draw_line(Vector2(-8,y),Vector2(1,y+1),Color(0.75,0.88,0.9,0.18),1,true)

static func box(c: CanvasItem, rect: Rect2, color: Color, radius: float = 6.0, border: Color = Color.TRANSPARENT) -> void:
	var style = StyleBoxFlat.new()
	style.bg_color = color
	style.set_corner_radius_all(int(radius))
	if border.a > 0:
		style.set_border_width_all(1)
		style.border_color = border
	c.draw_style_box(style, rect)
	# A restrained bevel catches the key light and keeps procedural props from
	# looking like flat vector stickers.
	if rect.size.x>12 and rect.size.y>8 and color.a>0.15:
		var inset=minf(maxf(radius,2.0),rect.size.x*0.2)
		c.draw_line(rect.position+Vector2(inset,1),rect.position+Vector2(rect.size.x-inset,1),Color(1,1,1,0.075*color.a),1,true)

static func _hex(at: Vector2, radius: float) -> PackedVector2Array:
	var pts=PackedVector2Array()
	for i in range(6): pts.append(at+Vector2.from_angle(float(i)*TAU/6.0-PI/2.0)*radius)
	return pts

static func grip(c: CanvasItem, from: Vector2, to: Vector2, width: float, color: Color = Color("71503c")) -> void:
	LabSurface.line(c,from,to,Color("182932"),width+2.0)
	LabSurface.line(c,from,to,color,width)
	var axis=(to-from).normalized()
	var cross=axis.orthogonal()*width*0.45
	for i in range(1,6):
		var p=from.lerp(to,float(i)/6.0)
		c.draw_line(p-cross-axis,p+cross+axis,color.darkened(0.48),1.1,true)
	LabSurface.line(c,from-cross,from+cross,Color("adc1ca"),2.8)
	LabSurface.line(c,to-cross,to+cross,Color("adc1ca"),2.2)

static func vents(c: CanvasItem, rect: Rect2, count: int = 4) -> void:
	for i in range(count):
		var x=rect.position.x+(float(i)+0.5)*rect.size.x/float(count)
		c.draw_line(Vector2(x,rect.position.y),Vector2(x-1,rect.end.y),Color("162833"),1.7,true)
		c.draw_line(Vector2(x+1,rect.position.y),Vector2(x,rect.end.y),Color(0.8,0.94,1,0.2),0.65,true)

static func blade(c: CanvasItem, outline: PackedVector2Array, spine: PackedVector2Array, color: Color = Color("c3d6e0")) -> void:
	LabSurface.polygon(c,outline,color)
	c.draw_polyline(spine,Color("f2fbff"),1.2,true)
	var edge=outline.duplicate()
	edge.append(outline[0])
	c.draw_polyline(edge,Color("e0f0f6"),0.65,true)

static func wear_noise(i: int) -> float:
	var v=sin(float(i)*91.7+float(i%23)*37.3)*23421.631
	return v-floorf(v)

static func damage(c: CanvasItem, rect: Rect2, wear: float, seed_value: int) -> void:
	# Progressive battle damage on a single plate: scuffs first, then dents,
	# then torn plating with the loom showing through. Deterministic per part,
	# so a robot keeps the same scars instead of shimmering as it is redrawn.
	if wear<=0.10: return
	for i in range(int(clampf(wear*8.0,1,8))):
		var from=rect.position+Vector2(rect.size.x*wear_noise(seed_value*7+i*13),rect.size.y*wear_noise(seed_value*11+i*17))
		var to=from+Vector2(3.0+wear_noise(seed_value+i*5)*6.0,-2.0+wear_noise(seed_value*3+i*7)*5.0)
		c.draw_line(from,to,Color(0.04,0.08,0.11,0.22+wear*0.34),1.0+wear,true)
	if wear>0.30:
		for i in range(int(clampf((wear-0.30)*7.0,1,3))):
			var at=rect.position+Vector2(rect.size.x*wear_noise(seed_value*19+i*29),rect.size.y*wear_noise(seed_value*23+i*31))
			var radius=2.0+wear*3.2
			c.draw_circle(at,radius,Color(0.16,0.24,0.30,0.38))
			c.draw_arc(at,radius,0.7,2.5,8,Color(1,1,1,0.28),1,true)
	if wear>0.55:
		# Placed by seed: a fixed fraction put an identical hole in every limb.
		var tear=Rect2(rect.position+rect.size*Vector2(0.12+wear_noise(seed_value*37)*0.34,0.16+wear_noise(seed_value*41)*0.44),rect.size*Vector2(0.42,0.26))
		c.draw_rect(tear,Color(0.14,0.22,0.28,0.65))
		c.draw_line(tear.position+Vector2(1,tear.size.y*0.42),tear.end-Vector2(1,tear.size.y*0.5),Color("c4703a"),1.5,true)
		c.draw_line(tear.position+Vector2(1,tear.size.y*0.74),tear.end-Vector2(1,tear.size.y*0.18),Color("3f9f74"),1.5,true)
		c.draw_polyline(PackedVector2Array([tear.position,tear.position+Vector2(tear.size.x*0.3,-2.5),tear.position+Vector2(tear.size.x*0.6,1.5),tear.position+Vector2(tear.size.x,-1.5)]),Color(0.55,0.62,0.66,0.5),1.5,true)
	if wear>0.80:
		# Live arcing across the worst breach.
		var arc_at=rect.position+rect.size*0.5
		c.draw_polyline(PackedVector2Array([arc_at+Vector2(-5,-3),arc_at+Vector2(-1,0),arc_at+Vector2(-3,2),arc_at+Vector2(4,5)]),Color(1.0,0.85,0.45,0.75),1.5,true)
		soft_glow(c,arc_at,7,Color(1.0,0.7,0.3,0.5),0.7)

static func icon(c: CanvasItem, kind: String, center: Vector2, scale_value: float = 1.0, color: Color = TEAL, rot: float = 0.0) -> void:
	if color==TEAL and EMITTER_COLORS.has(kind): color=EMITTER_COLORS[kind]
	if kind in LabVehicle.KINDS:
		LabVehicle.draw_icon(c,kind,center,scale_value,rot)
		return
	if kind in LabParts.KINDS:
		LabParts.draw_icon(c,kind,center,scale_value,rot)
		return
	if kind.begins_with("virus_"):
		var vc={"virus_rage":Color("ef6f62"),"virus_dance":Color("ff82ad"),"virus_panic":Color("ffcc55"),"virus_guard":Color("5da8ff"),"virus_leap":Color("a7e05c"),"virus_orbit":Color("b278e8"),"virus_float":Color("df7cf2"),"virus_hunter":Color("54d9ff"),"virus_follow":Color("65e39a"),"virus_spin":Color("4ce0bd")}.get(kind,color)
		c.draw_set_transform(center,rot,Vector2.ONE*scale_value)
		for side in [-1,1]:
			for pin in [-9,-3,3,9]:
				LabSurface.plate(c,Rect2(side*17-2,pin-1.4,4,2.8),Color("c8a766"),0.6)
				LabSurface.plate(c,Rect2(pin-1.4,side*17-2,2.8,4),Color("c8a766"),0.6)
		LabSurface.plate(c,Rect2(-16,-16,32,32),Color("2a4d46"),5,vc)
		LabSurface.plate(c,Rect2(-11,-11,22,22),Color("182b32"),3,Color("6c9f91"))
		for side in [-1,1]:
			c.draw_polyline(PackedVector2Array([Vector2(side*14,-10),Vector2(side*14,8),Vector2(side*10,13)]),Color("b1a26b"),0.8,true)
			bolt(c,Vector2(side*12,-12),1.0,Color("c9dbc4"))
		match kind:
			"virus_rage":
				LabSurface.polygon(c,PackedVector2Array([Vector2(0,-8),Vector2(8,6),Vector2(-8,6)]),vc)
			"virus_dance":
				LabSurface.circle(c,Vector2(-5,-2),3,vc); LabSurface.circle(c,Vector2(5,4),3,vc)
			"virus_panic":
				c.draw_polyline(PackedVector2Array([Vector2(-8,6),Vector2(-3,-6),Vector2(2,6),Vector2(8,-6)]),vc,2)
			"virus_guard":
				LabSurface.rect(c,Rect2(-6,-7,12,14),vc,false,2)
			"virus_leap":
				LabSurface.line(c,Vector2(0,8),Vector2(0,-8),vc,3); LabSurface.line(c,Vector2(-6,-2),Vector2(0,-8),vc,3); LabSurface.line(c,Vector2(6,-2),Vector2(0,-8),vc,3)
			"virus_orbit":
				c.draw_arc(Vector2.ZERO,9,0,4.2,16,vc,2,true); LabSurface.circle(c,Vector2(8,-4),3,vc)
			"virus_float":
				LabSurface.circle(c,Vector2(0,-4),4,vc); LabSurface.line(c,Vector2(-6,6),Vector2(6,6),vc,2)
			"virus_hunter":
				LabSurface.polygon(c,PackedVector2Array([Vector2(-8,-6),Vector2(8,0),Vector2(-8,6)]),vc)
			"virus_follow":
				LabSurface.circle(c,Vector2(-5,0),4,vc); LabSurface.circle(c,Vector2(6,0),3,vc)
			"virus_spin":
				c.draw_arc(Vector2.ZERO,8,-0.4,4.8,16,vc,2,true)
		c.draw_set_transform(Vector2.ZERO)
		return
	if kind.begins_with("robot_"):
		var colors={"robot_scout":Color("54d9ff"),"robot_titan":Color("d99b55"),"robot_jumper":Color("a7e05c"),"robot_magnet":Color("b278e8"),"robot_tesla":Color("5da8ff"),"robot_bomber":Color("ef6f62"),"robot_medic":Color("65e39a"),"robot_antigrav":Color("df7cf2"),"robot_runner":Color("ffcc55"),"robot_acrobat":Color("ff82ad")}
		var variant_color: Color=colors.get(kind,color)
		icon(c,"robot",center,scale_value,variant_color,rot)
		c.draw_set_transform(center,rot,Vector2.ONE*scale_value)
		match kind:
			"robot_scout":
				LabSurface.line(c,Vector2(-9,-25),Vector2(-15,-33),variant_color,2)
				LabSurface.circle(c,Vector2(-16,-34),2,AMBER)
			"robot_titan":
				LabSurface.rect(c,Rect2(-17,-23,34,48),variant_color,false,4)
				LabSurface.line(c,Vector2(-18,-2),Vector2(-25,15),variant_color,6)
				LabSurface.line(c,Vector2(18,-2),Vector2(25,15),variant_color,6)
			"robot_jumper":
				for x in [-8,8]: c.draw_polyline(PackedVector2Array([Vector2(x,28),Vector2(x-3,32),Vector2(x+3,35),Vector2(x,39)]),variant_color,2)
			"robot_magnet":
				c.draw_arc(Vector2(0,12),7,0,PI,14,variant_color,3,true)
			"robot_tesla":
				c.draw_polyline(PackedVector2Array([Vector2(-2,5),Vector2(5,5),Vector2(0,13),Vector2(6,13),Vector2(-4,23),Vector2(-1,15),Vector2(-7,15)]),AMBER,2)
			"robot_bomber":
				LabSurface.circle(c,Vector2(0,12),7,RED)
				LabSurface.line(c,Vector2(0,8),Vector2(0,14),TEXT,2)
				LabSurface.circle(c,Vector2(0,17),1,TEXT)
			"robot_medic":
				LabSurface.rect(c,Rect2(-2,5,4,15),TEXT)
				LabSurface.rect(c,Rect2(-7,10,14,5),TEXT)
			"robot_antigrav":
				LabSurface.line(c,Vector2(-8,31),Vector2(0,23),variant_color,3)
				LabSurface.line(c,Vector2(0,23),Vector2(8,31),variant_color,3)
			"robot_runner":
				LabSurface.line(c,Vector2(-20,8),Vector2(-29,8),variant_color,3)
				LabSurface.line(c,Vector2(-18,15),Vector2(-25,15),variant_color,2)
			"robot_acrobat":
				c.draw_arc(Vector2.ZERO,32,-2.2,-0.4,16,variant_color,2,true)
				LabSurface.polygon(c,PackedVector2Array([Vector2(25,-14),Vector2(18,-15),Vector2(22,-8)]),variant_color)
		c.draw_set_transform(Vector2.ZERO)
		return
	var artwork_scale=Vector2.ONE*scale_value
	if c is LabBody and LabGeometry.FRAMES.has(kind):
		var authored=LabGeometry.frame(kind)
		artwork_scale=c.dimensions/authored.size
		center-=authored.get_center()*artwork_scale
	c.draw_set_transform(center, rot, artwork_scale)
	# Catalog tiles render at roughly half scale, where fine detail turns to
	# mush; the in-world body gets the extra passes.
	var fine=scale_value>=0.8
	match kind:
		"robot":
			# Compact three-quarter mechanical silhouette for catalog cards.
			LabSurface.line(c,Vector2(0,-25),Vector2(0,-20),Color("8097a1"),2)
			soft_glow(c,Vector2(0,-28),7,Color(color.r,color.g,color.b,0.5),0.8)
			LabSurface.circle(c,Vector2(0,-28),3.2,AMBER)
			for x in [-15,15]:
				LabSurface.plate(c,Rect2(x-2,-15,4,8),Color("6e858f"),2)
			bevel_box(c,Rect2(-14,-22,28,21),Color("d9e6e9"),7,Color("78909a"),2)
			LabSurface.plate(c,Rect2(-11,-16,22,9),Color("102832"),4,Color("36505b"))
			for x in [-6,6]:
				LabSurface.circle(c,Vector2(x,-11.5),2.2,Color("06151c"))
				LabSurface.circle(c,Vector2(x,-12),1.35,color)
			LabSurface.rect(c,Rect2(-5,-1,10,5),Color("627985"))
			LabSurface.polygon(c,PackedVector2Array([Vector2(-11,3),Vector2(11,3),Vector2(9,24),Vector2(-9,24)]),color.darkened(0.08))
			c.draw_polyline(PackedVector2Array([Vector2(-11,3),Vector2(11,3),Vector2(9,24),Vector2(-9,24),Vector2(-11,3)]),Color("8aa0ad"),1.5,true)
			LabSurface.plate(c,Rect2(-6,8,12,10),Color("173039"),3)
			LabSurface.circle(c,Vector2(0,13),3.5,color.lightened(0.28))
			for s in [-1,1]:
				LabSurface.circle(c,Vector2(s*13,7),4.2,Color("607681"))
				LabSurface.circle(c,Vector2(s*13,7),2.2,TEXT)
				LabSurface.line(c,Vector2(s*14,9),Vector2(s*18,23),Color("d7e4e7"),5,true)
				LabSurface.circle(c,Vector2(s*18,24),3,Color("647b86"))
				LabSurface.line(c,Vector2(s*6,25),Vector2(s*8,36),Color("d7e4e7"),6,true)
				LabSurface.line(c,Vector2(s*8,36),Vector2(s*12,36),Color("91a9b2"),3,true)
		"crate":
			bevel_box(c,Rect2(-22,-22,44,44),Color("8d603d"),4,Color("d8a25f"),3)
			# Recessed boards, diagonal brace, grain and fasteners.
			LabSurface.plate(c,Rect2(-17,-17,34,34),Color("70472f"),2,Color("b77a49"))
			for x in [-12,0,12]: LabSurface.line(c,Vector2(x,-17),Vector2(x,17),Color("a66f43"),3)
			LabSurface.line(c,Vector2(-16,15),Vector2(15,-16),Color("d3a062"),7,true)
			LabSurface.line(c,Vector2(-15,13),Vector2(14,-16),Color("f0c17c"),1.4,true)
			for y in [-10,7]: LabSurface.line(c,Vector2(-9,y),Vector2(-2,y-2),Color(0.2,0.11,0.06,0.34),1)
			for p in [Vector2(-17,-17),Vector2(17,-17),Vector2(-17,17),Vector2(17,17)]: bolt(c,p,1.4,Color("d7aa70"))
		"barrel":
			bevel_box(c,Rect2(-18,-27,36,54),Color("964a3d"),8,Color("d88959"),3)
			LabSurface.plate(c,Rect2(-14,-23,7,46),Color(1,0.63,0.36,0.13),3)
			for y in [-17,17]:
				LabSurface.line(c,Vector2(-19,y),Vector2(19,y),Color("e4a268"),5,true)
				LabSurface.line(c,Vector2(-16,y-1),Vector2(16,y-1),Color("ffd096"),1,true)
			c.draw_arc(Vector2(0,-21),15,3.35,6.08,18,Color(1,0.72,0.46,0.35),2,true)
			LabSurface.polygon(c,PackedVector2Array([Vector2(0,-10),Vector2(10,8),Vector2(-10,8)]),AMBER)
			LabSurface.line(c,Vector2(0,-4),Vector2(0,2),BG,3)
			LabSurface.circle(c,Vector2(0,5),1.5,BG)
		"ball":
			soft_glow(c,Vector2.ZERO,25,Color(0.4,0.75,0.95,0.18),0.5)
			LabSurface.circle(c,Vector2(3,4),23,Color(0,0,0,0.28))
