			LabSurface.line(c,Vector2(-5,-9), Vector2(-1,-9), color, 1.2, true)
			LabSurface.line(c,Vector2(-3,-11), Vector2(-3,-7), color, 1.2, true)
		"pan":
			for v in [Vector2.UP,Vector2.DOWN,Vector2.LEFT,Vector2.RIGHT]:
				LabSurface.line(c,Vector2.ZERO,v*18,color,2)
				LabSurface.line(c,v*18,v*12+v.orthogonal()*5,color,2)
				LabSurface.line(c,v*18,v*12-v.orthogonal()*5,color,2)
	weapon_finish(c,kind,color)
	c.draw_set_transform(Vector2.ZERO)
